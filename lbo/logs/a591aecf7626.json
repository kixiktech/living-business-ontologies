   "kind": "tool_result",
   "text": "{\"columns\": [\"cust_id\", \"name\", \"email\"], \"rows\": [[\"cust_0042\", \"Ana Lund\", \"ana.lund42@example.com\"], [\"cust_0100\", \"Cara Novak\", \"cara.novak100@example.com\"]], \"truncated\": false, \"error\": null}",
